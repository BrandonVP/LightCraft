/*
===========================================================================
Name        : secrets.h.example
Description : Template for LightCraft credentials. Copy this file to secrets.h
              (which is gitignored) and fill in your own values.
===========================================================================
*/
#ifndef SECRETS_H
#define SECRETS_H

// Fallback only. Settings > WiFi saves the network you pick to flash, and that
// wins from then on; these are what a freshly flashed board uses until then.
// Leave them blank if you would rather set the network on the panel.
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// OpenWeatherMap: current-weather query fragment + API key.
// OWM_LOCATION is appended after "weather?", e.g. "zip=38002,us" or "q=Memphis,us".
#define OWM_API_KEY    "your-openweathermap-api-key"
#define OWM_LOCATION   "zip=38002,us"

// Local weather-station room-temp endpoint (its static IP + /room). Must match
// the ESP8266 weather station's STATIC_IP.
#define ROOM_URL       "http://192.168.68.240/room"

// --- Home Assistant (MQTT) --------------------------------------------------
// The broker, not Home Assistant's web port. With the Mosquitto add-on running
// inside Home Assistant OS these are the same machine, port 1883.
//
// The add-on has no user list of its own: it authenticates against Home
// Assistant's own accounts. Make a normal HA user (Settings > People > Add
// Person, "Allow person to login", admin not required) and put it here.
//
// Leave MQTT_HOST blank to keep the integration off regardless of the toggle in
// Settings > General.
#define MQTT_HOST      "192.168.68.90"
#define MQTT_PORT      1883
#define MQTT_USER      "mqtt"
#define MQTT_PASS      "the-password-you-set-for-that-user"

#endif // SECRETS_H
